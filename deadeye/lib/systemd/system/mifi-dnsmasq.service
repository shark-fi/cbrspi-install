[Unit]
Description=MiFi dnsmasq (DHCP + DNS on wlan0)
After=mifi-hostapd.service
Requires=mifi-hostapd.service
ConditionPathExists=/etc/wlanpi-mifi/dnsmasq.conf

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq -k --conf-file=/etc/wlanpi-mifi/dnsmasq.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
