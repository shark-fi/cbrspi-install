[Unit]
Description=MiFi hostapd (wlan0 AP for cellular sharing)
After=network.target
# config is generated by mifi-deadeye.sh on "on"
ConditionPathExists=/etc/wlanpi-mifi/hostapd.conf

[Service]
Type=simple
ExecStart=/usr/sbin/hostapd /etc/wlanpi-mifi/hostapd.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
